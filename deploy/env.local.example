TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# Siapa yang boleh tambah/hapus user (kosong = user pertama di ALLOWED_USERS)
TELEGRAM_ADMIN_USERS=
# Di grup: true = wajib @bot; false = hanya balas pesan mirip tracker (default)
TELEGRAM_GROUP_REQUIRE_MENTION=false
TELEGRAM_HOME_CHANNEL=
GOOGLE_API_KEY=

FINTRACKER_DB_PATH=./data/expenses.db

# Google Sheets (opsional) — butuh Service Account, bukan GOOGLE_API_KEY di atas
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-service-account.json
GOOGLE_SHEETS_WORKSHEET=DETAIL
# Layout: detail = Date|Category|Detail|Cost|Periode (+ id kolom F untuk undo)
# default = 8 kolom internal bot
GOOGLE_SHEETS_LAYOUT=detail
# Default kolom Category di sheet DETAIL (harus salah satu kategori Mahardiora)
GOOGLE_SHEETS_CATEGORY_DEFAULT=Daily
# Range tabel PLAN/SISA di sheet bulan (MAY, JUNE, …): baris 2 = header
GOOGLE_SHEETS_BUDGET_RANGE=A2:E25
